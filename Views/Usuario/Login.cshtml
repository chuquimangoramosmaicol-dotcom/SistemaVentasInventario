
@model SistemaVentasInventario.ViewModels.LoginVM

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Iniciar sesión - Colores &amp; Creaciones</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container min-vh-100 d-flex
                justify-content-center align-items-center">

        <div class="card shadow-sm p-4"
             style="width: 100%; max-width: 420px;">

            <div class="text-center mb-4">
                <h2 class="fw-bold">Colores &amp; Creaciones</h2>

                <p class="text-muted mb-0">
                    Sistema de ventas e inventario
                </p>
            </div>

            <h4 class="mb-3">Iniciar sesión</h4>

            <form asp-controller="Usuario"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Correo"
                           class="form-label">
                        Correo electrónico
                    </label>

                    <input asp-for="Correo"
                           class="form-control"
                           type="email"
                           autocomplete="username"
                           placeholder="Ingresa tu correo" />

                    <span asp-validation-for="Correo"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password"
                           class="form-label">
                        Contraseña
                    </label>

                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="Ingresa tu contraseña" />

                    <span asp-validation-for="Password"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100">
                    Ingresar
                </button>
            </form>

            <p class="text-muted text-center mt-4 mb-0">
                Acceso exclusivo para personal autorizado.
            </p>
        </div>
    </div>
</body>
</html>
